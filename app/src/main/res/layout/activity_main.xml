<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- What CRUX heard / said, so the interaction isn't purely invisible -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tts_greeting"
        android:textSize="18sp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.3" />

    <!-- Manual fallback / toggle: works whether or not wake-word mode is on -->
    <ImageButton
        android:id="@+id/micButton"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_mic_button"
        android:src="@android:drawable/ic_btn_speak_now"
        android:contentDescription="@string/mic_button_desc"
        app:layout_constraintBottom_toTopOf="@id/wakeWordToggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/wakeWordToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wakeword_toggle_label"
        app:layout_constraintBottom_toTopOf="@id/manageContactsButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/manageContactsButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manage_contacts_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
